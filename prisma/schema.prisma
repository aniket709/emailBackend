generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url  = env("DATABASE_URL")

}

 model EmailJob {
  id           String   @id @default(uuid())
  subject      String
  body         String
  scheduledAt  DateTime
  status       JobStatus @default(SCHEDULED)

  recipients   EmailRecipient[]

  createdAt    DateTime @default(now())
  attachments FileUpload[]
}

model EmailRecipient {
  id        String @id @default(uuid())
  email     String
  status    RecipientStatus @default(SCHEDULED)

  sentAt    DateTime?
  error     String?

  job       EmailJob @relation(fields: [jobId], references: [id])
  jobId     String
}

enum JobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum RecipientStatus {
  SCHEDULED
  SENT
  FAILED
}

model FileUpload {
  id         Int      @id @default(autoincrement())
  url        String
  publicId   String
  fileName   String
  size       Int
  mimeType   String?
  createdAt  DateTime @default(now())
   emailJobId String?   
  emailJob   EmailJob? @relation(fields: [emailJobId], references: [id])
}
